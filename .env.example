DATABASE_URL=postgresql://neondb_owner:npg_mNCpPS0awBJ2@ep-tiny-star-be196hjc-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 2. RENDER BACKEND CONFIGURATION
# Allowed CORS origins (Use * for all, or comma-separated Vercel frontend URLs)
CORS_ORIGINS=*
PORT=8000
PYTHON_VERSION=3.11.9

# 3. VERCEL FRONTEND CONFIGURATION
# Set in Vercel Project Settings > Environment Variables:
# Example: https://sellmygoods-backend.onrender.com/api/v1
VITE_API_URL=https://<your-render-app-name>.onrender.com/api/v1

